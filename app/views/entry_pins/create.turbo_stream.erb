<%= turbo_stream.replace "entry_detail" do %>
  <%= render "entries/detail", entry: @entry, pinned: Current.user.entry_pinned?(@entry) %>
<% end %>

<%= turbo_stream.replace "pin_badge" do %>
  <%= render "entry_pins/pin_badge", pinned_entries: @pinned_entries, pinned_count: @pinned_count %>
<% end %>
